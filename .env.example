# Runtime
NODE_ENV=development
LOG_LEVEL=info
LOG_BAILEYS=false
TZ=Asia/Jakarta
BOT_NAME=WaBot

# Login: qr | pairing
# Pakai "qr" jika WhatsApp bot ada di HP lain; "pairing" jika WhatsApp dan Termux di HP yang sama.
LOGIN_MODE=qr
BOT_PHONE_NUMBER=

# Nomor owner dan whitelist, pisahkan dengan koma.
# Boleh format 08xx, 628xx, atau +62 8xx.
OWNER_NUMBERS=
ALLOWED_NUMBERS=
ALLOWED_GROUPS=

# Stiker
STICKER_DEFAULT_POSITION=bottom
STICKER_MAX_CHARS=140
STICKER_FONT_PATH=assets/fonts/Anton-Regular.ttf
# Stiker animasi dari video/GIF dengan .s: durasi dipotong, encoder libwebp_anim dibutuhkan.
STICKER_ANIM_MAX_SEC=6
STICKER_ANIM_MAX_KB=300
MAX_IMAGE_MB=10

# Downloader
DOWNLOAD_MAX_MB=16
DOWNLOAD_SOURCE_MAX_MB=100
DOWNLOAD_MAX_DURATION_SEC=300
DOWNLOAD_CONCURRENCY=1
DOWNLOAD_TIMEOUT_MS=90000
MIN_FREE_DISK_MB=1024
MAX_QUEUE=20
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ENABLE_TIKWM_FALLBACK=true
# Export cookies Instagram (format Netscape) ke path ini. Jangan commit file-nya.
IG_COOKIES_PATH=data/cookies/instagram.txt

# Storage
DATA_DIR=data
TMP_DIR=data/tmp
AUTH_DIR=data/auth
